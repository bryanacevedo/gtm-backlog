{
  "name": "gtm-backlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GTM engineering backlog: requests land, get ranked by what they are worth to revenue, move from idea to live, and keep reporting after they ship.",
  "scripts": {
    "dev": "concurrently -k -n api,app \"node --watch src/server/node.ts\" \"vite\"",
    "build": "vite build",
    "demo": "vite build && node src/server/node.ts --reset",
    "db:reset": "node src/server/node.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "start": "node src/server/node.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.6.14",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260801.1": true
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Bryan Acevedo",
  "engines": {
    "node": ">=22.18"
  },
  "repository": "github:bryanacevedo/gtm-backlog"
}